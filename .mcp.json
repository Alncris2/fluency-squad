{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": ["@playwright/mcp@latest", "--config", "_opensquad/config/playwright.config.json"]
    },
    "supabase": {
      "command": "npx",
      "args": ["-y", "@supabase/mcp-server-supabase@latest", "--project-ref", "${SUPABASE_PROJECT_REF}"],
      "env": {
        "SUPABASE_ACCESS_TOKEN": "${SUPABASE_ACCESS_TOKEN}",
        "SUPABASE_ANON_KEY": "${SUPABASE_ANON_KEY}",
        "SUPABASE_PUBLIC_KEY": "${SUPABASE_PUBLIC_KEY}"
      }
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
      }
    },
    "laravel-boost": {
      "command": "${LARAVEL_BOOST_COMMAND}",
      "args": ["${LARAVEL_BOOST_ARGS}"],
      "cwd": "${BACKEND_PATH}"
    },
    "angular-cli": {
      "command": "npx",
      "args": ["npx", "@angular/cli", "mcp"],
      "cwd": "${FRONTEND_PATH}"
    }
  }
}
